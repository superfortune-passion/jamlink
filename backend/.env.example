PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# STUN + TURN (freeTURN — good for testing up to ~10 users)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:freeturn.net:3478
TURN_URL=turn:freeturn.net:3478,turns:freeturn.net:5349
TURN_USERNAME=free
TURN_CREDENTIAL=free

# Rate limiting
MAX_SEARCHES_PER_MINUTE=10
MAX_SKIPS_PER_MINUTE=20
MAX_REPORTS_PER_HOUR=5

# Jam mode
JAM_MODE_MAX_PARTICIPANTS=4
JAM_RELAY_REGIONS=us-east,us-west,eu-west
